{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kafka values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": { "$ref": "#/$defs/global" },
    "pvc": { "$ref": "#/$defs/pvc" },
    "operator": { "$ref": "#/$defs/operator" },
    "kafka": { "$ref": "#/$defs/kafka" },
    "groupMigration": { "$ref": "#/$defs/groupMigration" },
    "SERVICE_NAME": {
      "type": "string",
      "description": "The name of the Service exposed for the database. Default is `kafka` or `kafka-services` depending on the chart."
    },
    "PART_OF": {
      "type": "string",
      "description": "Microservice belonging to a group. Default is `kafka` or `kafka-services` depending on the chart."
    },
    "DELIMITER": {
      "type": "string",
      "default": "-",
      "description": "Delimiter for labels."
    },
    "ARTIFACT_DESCRIPTOR_VERSION": {
      "type": "string",
      "default": "",
      "description": "Artifact descriptor version which is installed."
    },
    "nameOverride": {
      "type": ["string", "null"],
      "description": "Override the chart name used in resource names."
    },
    "fullnameOverride": {
      "type": ["string", "null"],
      "description": "Override the fully qualified app name."
    },
    "serviceAccount": {
      "description": "Service account name or configuration used by generic helpers.",
      "oneOf": [
        { "type": ["string", "null"] },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" }
          }
        }
      ]
    }
  },
  "$defs": {
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "properties": {
            "cpu": {
              "comment": "don't use type field, because it breaks backward compatibility"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "properties": {
            "cpu": {
              "comment": "don't use type field, because it breaks backward compatibility"
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "request": { "type": "string" }
            }
          }
        }
      }
    },
    "affinity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "nodeAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferredDuringSchedulingIgnoredDuringExecution": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            },
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "podAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferredDuringSchedulingIgnoredDuringExecution": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            },
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "podAntiAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferredDuringSchedulingIgnoredDuringExecution": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            },
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            }
          }
        }
      }
    },
    "tolerations": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "operator": { "type": "string", "enum": ["Equal", "Exists"] },
          "value": { "type": "string" },
          "effect": {
            "type": "string",
            "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"]
          },
          "tolerationSeconds": { "type": "integer" }
        }
      }
    },
    "podSecurityContext": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "runAsUser": { "type": "integer" },
        "runAsGroup": { "type": "integer" },
        "fsGroup": { "type": "integer" },
        "runAsNonRoot": { "type": "boolean" },
        "fsGroupChangePolicy": { "type": "string" },
        "seLinuxOptions": { "type": "object", "additionalProperties": true },
        "seccompProfile": { "type": "object", "additionalProperties": true },
        "supplementalGroups": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "sysctls": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "windowsOptions": { "type": "object", "additionalProperties": true }
      }
    },
    "stringMap": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "string" }
    },
    "tlsCertificates": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "crt": { "type": ["string", "null"], "description": "Certificate in base64 format." },
        "key": { "type": ["string", "null"], "description": "Private key in base64 format." },
        "ca": { "type": ["string", "null"], "description": "Root CA certificate in base64 format." }
      }
    },
    "subjectAlternativeName": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "additionalDnsNames": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional DNS names added to the certificate SAN field."
        },
        "additionalIpAddresses": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional IP addresses added to the certificate SAN field."
        }
      }
    },
    "kraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether KRaft mode is enabled." },
        "migration": { "type": "boolean", "description": "Whether KRaft migration is enabled." },
        "migrationTimeout": { "type": "integer", "description": "Timeout for Kafka pods during KRaft migration." },
        "skipUpgradeCheck": {
          "type": "boolean",
          "description": "Whether to skip Kafka 4.x upgrade validation from ZooKeeper-based versions."
        }
      }
    },
    "ssl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string" },
        "cipherSuites": {
          "type": "array",
          "items": { "type": "string" }
        },
        "enableTwoWaySsl": { "type": "boolean" },
        "allowNonencryptedAccess": { "type": "boolean" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "size": { "type": "string", "description": "Persistent volume size." },
        "volumes": { "type": "array", "items": { "type": "string" } },
        "nodes": { "type": "array", "items": { "type": "string" } },
        "labels": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reassignPartitions": { "type": ["boolean", "null"] },
        "brokerDeploymentScaleInEnabled": { "type": ["boolean", "null"] },
        "allBrokersStartTimeoutSeconds": { "type": ["integer", "null"] },
        "topicReassignmentTimeoutSeconds": { "type": ["integer", "null"] }
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clockSkew": { "type": ["integer", "null"] },
        "jwkSourceType": {
          "type": ["string", "null"],
          "enum": ["", "jwks", "keystore", null]
        },
        "jwksConnectionTimeout": { "type": ["integer", "null"] },
        "jwksReadTimeout": { "type": ["integer", "null"] },
        "jwksSizeLimit": { "type": ["integer", "null"] }
      }
    },
    "probeTimingConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": { "type": ["integer", "null"] },
        "timeoutSeconds": { "type": ["integer", "null"] },
        "periodSeconds": { "type": ["integer", "null"] },
        "successThreshold": { "type": ["integer", "null"] },
        "failureThreshold": { "type": ["integer", "null"] }
      }
    },
    "pvc": {
      "type": "object",
      "additionalProperties": false,
      "description": "Common PVC configuration applied by the operator.",
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "$ref": "#/$defs/stringMap",
              "description": "Custom annotations added to all Persistent Volume Claims created by the operator."
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "default": "kafka",
          "description": "Custom resource name used to form service names."
        },
        "waitForPodsReady": {
          "type": "boolean",
          "default": true,
          "description": "Whether the operator should wait for pods to be ready before publishing CR status."
        },
        "podReadinessTimeout": {
          "type": "integer",
          "default": 600,
          "description": "Timeout in seconds for waiting until pods are ready."
        },
        "monitoringType": {
          "type": "string",
          "enum": ["prometheus", "influxdb"],
          "default": "prometheus",
          "description": "Monitoring output plugin type."
        },
        "installDashboard": {
          "type": "boolean",
          "default": true,
          "description": "Whether Grafana dashboards are applied."
        },
        "restrictedEnvironment": {
          "type": "boolean",
          "default": false,
          "description": "Whether the deployment is performed in a restricted access environment."
        },
        "ipv6": {
          "type": "boolean",
          "default": false,
          "description": "Whether IPv6 is used."
        },
        "smDbHost": {
          "type": ["string", "null"],
          "description": "Host of the System Monitoring database. Required when monitoringType is influxdb."
        },
        "smDbName": {
          "type": ["string", "null"],
          "description": "Name of the System Monitoring database. Required when monitoringType is influxdb."
        },
        "cloudIntegrationEnabled": {
          "type": "boolean",
          "description": "Whether to apply global cloud parameters instead of service-specific ones."
        },
        "customLabels": {
          "$ref": "#/$defs/stringMap",
          "description": "Custom labels for all Kafka Service pods."
        },
        "defaultLabels": {
          "$ref": "#/$defs/stringMap",
          "description": "Default labels applied by the operator."
        },
        "securityContext": {
          "$ref": "#/$defs/podSecurityContext",
          "description": "Pod security context for all Kafka Service pods."
        },
        "kafkaSaslMechanism": {
          "type": "string",
          "description": "SASL mechanism used to connect to Kafka."
        },
        "kafkaSsl": { "$ref": "#/$defs/ssl" },
        "kraft": { "$ref": "#/$defs/kraft" },
        "kafka": {
          "type": "object",
          "additionalProperties": true,
          "description": "Legacy nested TLS overrides used by the kafka chart.",
          "properties": {
            "tls": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "cipherSuites": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether to use TLS to connect to Kafka services."
            },
            "cipherSuites": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "TLS cipher suites."
            },
            "allowNonencryptedAccess": {
              "type": "boolean",
              "default": true,
              "description": "Whether to allow non-encrypted access to Kafka."
            },
            "insecureSkipTlsVerify": {
              "type": "boolean",
              "description": "Skip TLS certificate verification."
            },
            "serverName": {
              "type": "string",
              "description": "TLS server name used by clients."
            },
            "generateCerts": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to generate TLS certificates."
                },
                "certProvider": {
                  "type": "string",
                  "enum": ["helm", "cert-manager"],
                  "default": "cert-manager",
                  "description": "Provider used to generate TLS certificates."
                },
                "durationDays": {
                  "type": "integer",
                  "default": 365,
                  "description": "TLS certificate validity duration in days."
                },
                "clusterIssuerName": {
                  "type": "string",
                  "default": "",
                  "description": "Name of the cert-manager ClusterIssuer resource."
                }
              }
            }
          }
        },
        "externalKafka": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether to use an external Kafka cluster."
            },
            "bootstrapServers": {
              "type": "string",
              "default": "",
              "description": "Comma-separated list of host:port pairs of external Kafka."
            },
            "replicas": {
              "type": "string",
              "default": "",
              "description": "Number of external Kafka servers."
            },
            "saslMechanism": {
              "type": "string",
              "default": "",
              "description": "SASL mechanism used in external Kafka."
            },
            "enableSsl": {
              "type": "boolean",
              "default": false,
              "description": "Whether to use SSL to connect to external Kafka."
            },
            "sslSecretName": {
              "type": "string",
              "default": "",
              "description": "Secret that contains SSL certificates."
            },
            "username": {
              "type": "string",
              "default": "",
              "description": "Username of the external Kafka admin user."
            },
            "password": {
              "type": "string",
              "default": "",
              "description": "Password of the external Kafka admin user."
            }
          }
        },
        "velero": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "preHookBackupEnabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether Velero backup pre-hook with Backup Daemon is enabled."
            },
            "postHookRestoreEnabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether Velero restore post-hook with Backup Daemon is enabled."
            }
          }
        },
        "disasterRecovery": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "siteManagerApiGroup": {
              "type": "string",
              "default": "netcracker.com",
              "description": "API group used by Site Manager resources."
            },
            "image": {
              "type": "string",
              "description": "Disaster Recovery daemon container image."
            },
            "customLabels": {
              "$ref": "#/$defs/stringMap",
              "description": "Custom labels for Disaster Recovery resources."
            },
            "tls": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to use TLS to connect to Disaster Recovery."
                },
                "allowNonencryptedAccess": {
                  "type": "boolean",
                  "description": "Whether non-encrypted access to DRD is allowed."
                },
                "certificates": { "$ref": "#/$defs/tlsCertificates" },
                "secretName": {
                  "type": "string",
                  "default": "",
                  "description": "Secret that contains Disaster Recovery TLS certificates."
                },
                "cipherSuites": {
                  "type": "array",
                  "items": { "type": "string" },
                  "default": [],
                  "description": "TLS cipher suites that override global.tls.cipherSuites."
                },
                "subjectAlternativeName": { "$ref": "#/$defs/subjectAlternativeName" }
              }
            },
            "httpAuth": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether Disaster Recovery HTTP authentication is enabled."
                },
                "smSecureAuth": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether smSecureAuth mode is enabled for Site Manager."
                },
                "smNamespace": {
                  "type": "string",
                  "default": "site-manager",
                  "description": "Namespace from which Site Manager API calls are made."
                },
                "smServiceAccountName": {
                  "type": "string",
                  "default": "",
                  "description": "Service account used for Site Manager API calls."
                },
                "restrictedEnvironment": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether to bind system:auth-delegator for DR authentication."
                },
                "customAudience": {
                  "type": "string",
                  "default": "sm-services",
                  "description": "Custom audience for the REST API token."
                }
              }
            },
            "mode": {
              "type": "string",
              "enum": ["", "active", "standby", "disabled"],
              "default": "",
              "description": "Disaster Recovery mode of the current site."
            },
            "region": {
              "type": "string",
              "default": "",
              "description": "Cloud region of the current Kafka Service instance."
            },
            "siteManagerEnabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether to use Site Manager."
            },
            "afterServices": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "SiteManager names after which Kafka switchover is run."
            },
            "serviceExport": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether to create a GKE ServiceExport resource."
                }
              }
            },
            "mirrorMakerReplication": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether Kafka replication via Mirror Maker is enabled in DR mode."
                }
              }
            },
            "topicsBackup": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether topic configuration replication via Backup Daemon is enabled."
                }
              }
            },
            "resources": { "$ref": "#/$defs/resourceRequirements" }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kafka": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "disableSecurity": {
                  "type": "boolean",
                  "default": false,
                  "description": "Disables Kafka authentication when true."
                },
                "adminUsername": {
                  "type": "string",
                  "default": "",
                  "description": "Username of the internal administrator Kafka user."
                },
                "adminPassword": {
                  "type": "string",
                  "default": "",
                  "description": "Password of the internal administrator Kafka user."
                },
                "clientUsername": {
                  "type": "string",
                  "default": "",
                  "description": "Username of the external Kafka client user."
                },
                "clientPassword": {
                  "type": "string",
                  "default": "",
                  "description": "Password of the external Kafka client user."
                },
                "zookeeperClientUsername": {
                  "type": "string",
                  "description": "Username of the ZooKeeper client user."
                },
                "zookeeperClientPassword": {
                  "type": "string",
                  "description": "Password of the ZooKeeper client user."
                }
              }
            },
            "monitoring": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "prometheusUsername": {
                  "type": "string",
                  "default": "",
                  "description": "Username for Prometheus authentication."
                },
                "prometheusPassword": {
                  "type": "string",
                  "default": "",
                  "description": "Password for Prometheus authentication."
                },
                "smDbUsername": {
                  "type": "string",
                  "default": "",
                  "description": "System Monitoring database username."
                },
                "smDbPassword": {
                  "type": "string",
                  "default": "",
                  "description": "System Monitoring database password."
                }
              }
            },
            "akhq": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "defaultUsername": {
                  "type": "string",
                  "default": "",
                  "description": "Username of the default AKHQ user."
                },
                "defaultPassword": {
                  "type": "string",
                  "default": "",
                  "description": "Password of the default AKHQ user."
                },
                "schemaRegistryUsername": {
                  "type": "string",
                  "default": "",
                  "description": "Username of the Schema Registry user."
                },
                "schemaRegistryPassword": {
                  "type": "string",
                  "default": "",
                  "description": "Password of the Schema Registry user."
                }
              }
            },
            "backupDaemon": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "username": {
                  "type": "string",
                  "default": "",
                  "description": "Username of the Backup Daemon API user."
                },
                "password": {
                  "type": "string",
                  "default": "",
                  "description": "Password of the Backup Daemon API user."
                },
                "s3": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "keyId": {
                      "type": "string",
                      "default": "",
                      "description": "Access key ID for S3 storage."
                    },
                    "keySecret": {
                      "type": "string",
                      "default": "",
                      "description": "Secret access key for S3 storage."
                    }
                  }
                }
              }
            },
            "cruiseControl": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "adminUsername": {
                  "type": "string",
                  "default": "",
                  "description": "Username for the Cruise Control UI admin user."
                },
                "adminPassword": {
                  "type": "string",
                  "default": "",
                  "description": "Password for the Cruise Control UI admin user."
                },
                "viewerUsername": {
                  "type": "string",
                  "default": "",
                  "description": "Username for the Cruise Control UI viewer user."
                },
                "viewerPassword": {
                  "type": "string",
                  "default": "",
                  "description": "Password for the Cruise Control UI viewer user."
                }
              }
            },
            "integrationTests": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "zabbix": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "username": { "type": "string", "default": "" },
                    "password": { "type": "string", "default": "" }
                  }
                },
                "idp": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "username": { "type": "string", "default": "" },
                    "password": { "type": "string", "default": "" },
                    "registrationToken": { "type": "string", "default": "" }
                  }
                },
                "prometheus": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "user": { "type": "string", "default": "" },
                    "password": { "type": "string", "default": "" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dockerImage": {
          "type": "string",
          "description": "Image of Kafka Service Operator."
        },
        "replicas": {
          "type": "integer",
          "default": 1,
          "description": "Number of Kafka Service Operator pods."
        },
        "apiGroup": {
          "type": "string",
          "default": "netcracker.com",
          "description": "Primary API group used by the operator."
        },
        "secondaryApiGroup": {
          "type": "string",
          "default": "",
          "description": "Secondary API group used by the operator."
        },
        "kmmConfiguratorEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether the operator manages KmmConfig custom resources."
        },
        "watchNamespace": {
          "type": "string",
          "description": "Namespaces watched by the operator."
        },
        "serviceAccount": {
          "type": "string",
          "description": "Service account used to deploy Kafka Service. Empty value creates the default account."
        },
        "resources": { "$ref": "#/$defs/resourceRequirements" },
        "affinity": { "$ref": "#/$defs/affinity" },
        "tolerations": { "$ref": "#/$defs/tolerations" },
        "priorityClassName": {
          "type": "string",
          "default": "",
          "description": "Priority class used by the Kafka Service Operator pod."
        },
        "akhqConfigurator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether the AKHQ protobuf deserialization controller is started."
            },
            "watchNamespace": {
              "type": "string",
              "default": "",
              "description": "Comma-separated namespaces watched for AkhqConfig resources."
            }
          }
        },
        "kafkaUserConfigurator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether the KafkaUser controller is started."
            },
            "secretCreatingEnabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether the KafkaUser service account can create secrets in other namespaces."
            },
            "watchNamespace": {
              "type": "string",
              "default": "",
              "description": "Comma-separated namespaces watched for KafkaUser resources."
            }
          }
        },
        "customLabels": { "$ref": "#/$defs/stringMap" },
        "securityContext": { "$ref": "#/$defs/podSecurityContext" }
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "boolean",
          "description": "Whether the Kafka component is deployed. Must be false when using external Kafka."
        },
        "replicas": {
          "type": "integer",
          "default": 3,
          "description": "Number of Kafka servers."
        },
        "dockerImage": {
          "type": "string",
          "description": "Docker image of Kafka."
        },
        "autoRestartOnSecretChange": {
          "type": "boolean",
          "default": true,
          "description": "Whether Kafka restarts automatically when TLS secrets change."
        },
        "getRacksFromNodeLabels": {
          "type": ["boolean", "null"],
          "description": "Whether Kafka racks are taken from node labels."
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether TLS is enabled for Kafka."
            },
            "secretName": {
              "type": "string",
              "default": "",
              "description": "Secret that contains Kafka TLS certificates."
            },
            "certificates": { "$ref": "#/$defs/tlsCertificates" },
            "cipherSuites": {
              "type": "array",
              "items": { "type": "string" }
            },
            "enableTwoWaySsl": { "type": "boolean" },
            "allowNonencryptedAccess": { "type": "boolean" },
            "subjectAlternativeName": { "$ref": "#/$defs/subjectAlternativeName" }
          }
        },
        "ssl": { "$ref": "#/$defs/ssl" },
        "storage": { "$ref": "#/$defs/storage" },
        "affinity": { "$ref": "#/$defs/affinity" },
        "tolerations": { "$ref": "#/$defs/tolerations" },
        "priorityClassName": { "type": "string" },
        "disableSecurity": { "type": ["boolean", "null"] },
        "heapSize": { "type": "integer" },
        "oauth": { "$ref": "#/$defs/oauth" },
        "scaling": { "$ref": "#/$defs/scaling" },
        "resources": { "$ref": "#/$defs/resourceRequirements" },
        "secretName": { "type": "string" },
        "securityContext": { "$ref": "#/$defs/podSecurityContext" },
        "nodeLabelNameForRack": { "type": "string" },
        "racks": { "type": "array", "items": { "type": "string" } },
        "terminationGracePeriod": { "type": ["integer", "null"] },
        "zookeeperConnect": { "type": "string" },
        "zookeeperEnableSsl": { "type": "boolean" },
        "zookeeperSslSecretName": { "type": "string" },
        "zookeeperSetACL": { "type": ["boolean", "null"] },
        "externalHostNames": { "type": "array", "items": { "type": "string" } },
        "externalPorts": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "integer" },
              { "type": "string" }
            ]
          }
        },
        "environmentVariables": { "type": "array", "items": { "type": "string" } },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "boolean", "integer", "number", "null"]
          },
          "description": "Native Kafka broker configuration properties. Keys are preserved exactly as specified."
        },
        "rollbackTimeout": { "type": ["integer", "null"] },
        "healthCheckTimeout": { "type": ["integer", "null"] },
        "enableAuditLogs": { "type": ["boolean", "null"] },
        "tokenRolesPath": { "type": "string" },
        "enableAuthorization": { "type": ["boolean", "null"] },
        "consulDiscovery": { "type": "boolean" },
        "registeredServiceName": { "type": "string" },
        "kafkaDiscoveryMeta": { "$ref": "#/$defs/stringMap" },
        "kafkaDiscoveryTags": { "type": "array", "items": { "type": "string" } },
        "consulAclEnabled": { "type": "boolean" },
        "consulAuthMethod": { "type": "string" },
        "rollingUpdate": { "type": "boolean" },
        "customLabels": { "$ref": "#/$defs/stringMap" },
        "defaultLabels": { "$ref": "#/$defs/stringMap" },
        "debugContainer": { "type": "boolean" },
        "ccMetricReporterEnabled": { "type": "boolean" },
        "kraft": { "$ref": "#/$defs/kraft" },
        "kafka3dockerImage": {
          "type": "string",
          "description": "Docker image of Kafka 3.x used during KRaft migration."
        },
        "disruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": { "type": "integer" }
          }
        },
        "livenessProbe": { "$ref": "#/$defs/probeTimingConfig" },
        "readinessProbe": { "$ref": "#/$defs/probeTimingConfig" },
        "livenessProbeInitialDelay": { "type": "integer" },
        "livenessProbeTimeout": { "type": "integer" },
        "readinessProbeInitialDelay": { "type": "integer" },
        "readinessProbeTimeout": { "type": "integer" },
        "createExternalServices": { "type": "boolean" },
        "externalTrafficPolicy": { "type": "string", "enum": ["Cluster", "Local"] },
        "idpWhitelist": { "type": "string" },
        "migrationController": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "affinity": { "$ref": "#/$defs/affinity" },
            "tolerations": { "$ref": "#/$defs/tolerations" },
            "priorityClassName": { "type": "string" },
            "heapSize": { "type": "integer" },
            "resources": { "$ref": "#/$defs/resourceRequirements" },
            "securityContext": { "$ref": "#/$defs/podSecurityContext" },
            "storage": { "$ref": "#/$defs/storage" }
          }
        },
        "metadata": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "Present on the Kafka CR type; accepted for schema completeness."
        },
        "spec": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "Present on the Kafka CR type; accepted for schema completeness."
        },
        "status": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "Present on the Kafka CR type; accepted for schema completeness."
        }
      }
    },
    "groupMigration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "oldGroupPrefix": { "type": "string", "default": "qubership.org/" },
        "labelSelector": { "type": "string", "default": "" },
        "resources": { "$ref": "#/$defs/resourceRequirements" },
        "image": { "type": "string" },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "default": "Always"
        },
        "runAsNonRoot": { "type": "boolean", "default": true }
      }
    }
  }
}
